<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trajopt_ros</name>
  <version>0.1.0</version>
  <description>
    ROS 2 wrappers for trajopt_core: a platform-independent A* node and MPC node
    whose topic names are relative and remapped per robot in the launch files.
    The nodes hold no algorithm and no platform knowledge.
  </description>
  <maintainer email="franci.pedrini@gmail.com">Francesco Pedrini</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>trajopt_core</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
